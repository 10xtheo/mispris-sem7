<mxfile host="app.diagrams.net"><diagram name="04_classes_interpreter"><mxGraphModel page="1" pageWidth="900" pageHeight="830"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f" value="&lt;b&gt;Функция&lt;/b&gt;&lt;hr&gt;код; формальные параметры&lt;br&gt;тип результата; выражение" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=24;spacing=10;fillColor=#ffffff;strokeColor=#000000;"><mxGeometry as="geometry" x="20" y="20" width="400" height="124" /></mxCell><mxCell id="c" value="&lt;b&gt;Ограничение&lt;/b&gt;&lt;hr&gt;типовое изделие; имя&lt;br&gt;логическое выражение" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=24;spacing=10;fillColor=#ffffff;strokeColor=#000000;"><mxGeometry as="geometry" x="480" y="20" width="400" height="124" /></mxCell><mxCell id="i" value="&lt;b&gt;Интерпретатор&lt;/b&gt;&lt;hr&gt;проверить структуру и типы&lt;br&gt;вычислить; ограничить глубину&lt;br&gt;обнаружить цикл; отклонить ошибку" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=24;spacing=10;fillColor=#ffffff;strokeColor=#000000;"><mxGeometry as="geometry" x="210" y="260" width="480" height="155" /></mxCell><mxCell id="n" value="&lt;b&gt;Узлы выражения (JSONB)&lt;/b&gt;&lt;hr&gt;const — константа; param — параметр&lt;br&gt;op — операция и аргументы; call — функция и аргументы" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=24;spacing=10;fillColor=#ffffff;strokeColor=#000000;"><mxGeometry as="geometry" x="20" y="520" width="860" height="124" /></mxCell><mxCell id="e0" value="определения" source="f" target="i" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;fontFamily=Times New Roman;fontSize=24;labelBackgroundColor=#ff